{
  "authority": {
    "allow": [
      "source_change"
    ],
    "deny": [
      "destructive_rewrite"
    ],
    "mode": "ai-managed"
  },
  "channels": [],
  "coordination": {
    "gc": {
      "backup_keep": 2,
      "backup_retention_days": 30,
      "worktree_grace_days": 7
    },
    "id": "default",
    "mode": "active-active",
    "remote": "origin",
    "state_branch": "syncwheel/state/default"
  },
  "defaults": {
    "base_branch": "main",
    "base_ref": "origin/main",
    "canonical_remote": "origin",
    "integration_membership": "required",
    "publication_remote": "origin",
    "replay_mode": "auto"
  },
  "integration": {
    "base": "origin/main",
    "branch": "main-integration",
    "stacks": [
      "stable-legacy-state-recovery"
    ],
    "strategy": "cherry-pick"
  },
  "repository_mode": "delivery",
  "stacks": [
    {
      "base": "origin/main",
      "branch": "pr/stable-legacy-state-recovery",
      "commits": [
        "0d1acc97c7ccfb7f3d67f47b19b416de65d786fb"
      ],
      "id": "stable-legacy-state-recovery",
      "integration_branch": "main-integration",
      "meta": {
        "purpose": "Allow explicit stable-state recovery while preserving disagreeing legacy manifests"
      },
      "publication": {
        "enabled": true
      },
      "state": "published",
      "target_branch": "main",
      "target_remote": "origin"
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "version": 2
}
