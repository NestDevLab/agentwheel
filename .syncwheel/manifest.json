{
  "version": 2,
  "defaults": {
    "canonical_remote": "origin",
    "publication_remote": "origin",
    "base_branch": "main",
    "base_ref": "origin/main",
    "integration_membership": "required",
    "replay_mode": "auto"
  },
  "integration": {
    "branch": "main-integration",
    "base": "origin/main",
    "strategy": "cherry-pick",
    "stacks": [
      "skill-evolution-v01"
    ]
  },
  "stacks": [
    {
      "id": "skill-evolution-v01",
      "branch": "pr/skill-evolution-v01",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [],
      "state": "published",
      "publication": {
        "enabled": true
      },
      "meta": {
        "purpose": "Implement OpenPack source-aware skill evolution"
      }
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel",
  "coordination": {
    "mode": "active-active",
    "id": "default",
    "remote": "origin",
    "state_branch": "syncwheel/state/default",
    "gc": {
      "worktree_grace_days": 7,
      "backup_retention_days": 30,
      "backup_keep": 2
    }
  },
  "repository_mode": "delivery",
  "channels": []
}
