{
  "version": 1,
  "defaults": {
    "canonical_remote": "origin",
    "publication_remote": "origin",
    "base_branch": "main",
    "base_ref": "origin/main"
  },
  "integration": {
    "branch": "main-integration",
    "base": "origin/main",
    "strategy": "cherry-pick",
    "stacks": [
      "only-source-selector-scope"
    ]
  },
  "stacks": [
    {
      "id": "only-source-selector-scope",
      "branch": "codex/only-source-selector-scope",
      "base": "origin/main",
      "target_remote": "origin",
      "target_branch": "main",
      "integration_branch": "main-integration",
      "commits": [],
      "meta": {
        "purpose": "Scope CLI selectors to explicit install source"
      }
    }
  ],
  "syncwheel_tracking": "git-tracked",
  "syncwheel_worktree_root": "var/syncwheel"
}
