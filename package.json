{
  "name": "agentwheel",
  "version": "0.19.9",
  "description": "Weave skills, rules, and instructions across every AI agent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NestDevLab/agentwheel.git"
  },
  "homepage": "https://www.nestdev.it/agentwheel/",
  "bugs": {
    "url": "https://github.com/NestDevLab/agentwheel/issues"
  },
  "keywords": [
    "ai-agent",
    "agents",
    "skills",
    "rules",
    "instructions",
    "mcp",
    "openclaw",
    "claude",
    "codex",
    "copilot"
  ],
  "bin": {
    "agentwheel": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "openpack.json",
    "install.md",
    "AGENT.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "prepack": "pnpm build",
    "release:check": "node scripts/release-check.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@skillkit/core": "1.24.0",
    "commander": "14.0.2",
    "jsonc-parser": "3.3.1",
    "typescript": "5.9.3",
    "yaml": "2.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsup": "8.5.1",
    "vitest": "4.0.15"
  },
  "packageManager": "pnpm@10.23.0",
  "optionalDependencies": {
    "mermaid": "^11.16.0"
  }
}
